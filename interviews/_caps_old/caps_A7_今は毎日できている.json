[
 {
  "in": 0.0,
  "out": 2.25,
  "text": "変わられたと思いますか?"
 },
 {
  "in": 7.9,
  "out": 11.61,
  "text": "まだできることはまだ限\nられてると思うんです"
 },
 {
  "in": 11.36,
  "out": 15.25,
  "text": "がそれでもちゃんと\nパソコンを開いて"
 },
 {
  "in": 15.62,
  "out": 19.91,
  "text": "ブログの続きを書くとかブログの"
 },
 {
  "in": 19.66,
  "out": 23.99,
  "text": "サムネイルをジェミンや\nキャンバーを使って"
 },
 {
  "in": 23.74,
  "out": 27.79,
  "text": "書くとか作るとかそういう"
 },
 {
  "in": 27.54,
  "out": 31.85,
  "text": "勉強ですよねそれってそれ"
 },
 {
  "in": 31.6,
  "out": 34.19,
  "text": "が毎日できてるんですよね"
 },
 {
  "in": 36.94,
  "out": 41.27,
  "text": "ブログに書いてることって結\n構私ノートに付けてたこと"
 },
 {
  "in": 41.02,
  "out": 45.11,
  "text": "もあるんですけれども頭\nの中に入っていること"
 },
 {
  "in": 44.86,
  "out": 49.29,
  "text": "要はインプットしてきたこ\nとを今アウトプットする"
 },
 {
  "in": 49.04,
  "out": 53.33,
  "text": "ようだアウトプットしてる状"
 },
 {
  "in": 53.08,
  "out": 56.91,
  "text": "態ですよねそれがす\nごく勉強になって"
 },
 {
  "in": 59.48,
  "out": 62.91,
  "text": "そういうアウトプット\nして表現している"
 },
 {
  "in": 64.24,
  "out": 68.45,
  "text": "っていうことがすごく楽"
 },
 {
  "in": 68.2,
  "out": 72.39,
  "text": "しいですよね学びの"
 },
 {
  "in": 72.14,
  "out": 76.49,
  "text": "時間そのものが楽し\nくて好奇心を刺激"
 },
 {
  "in": 76.24,
  "out": 79.95,
  "text": "してくれてそれが実際に行動を"
 },
 {
  "in": 79.7,
  "out": 84.05,
  "text": "して成果というか作品アウト\nプットにもつながっている"
 },
 {
  "in": 83.8,
  "out": 87.99,
  "text": "というのが続いてるというこ\nとですよね続いてますね"
 },
 {
  "in": 88.12,
  "out": 91.79,
  "text": "楽しくないと続かないですも\nんね先生何度もおっしゃ"
 },
 {
  "in": 91.54,
  "out": 95.13,
  "text": "ってましたけどねやっぱり楽\nしいんですよね楽しいこれ"
 },
 {
  "in": 94.88,
  "out": 96.17,
  "text": "続いてますね"
 }
]